@@ -901,6 +908,35 @@ @_spi(GemmaEncoder) public class Gemma4TextModelInner: Module {
         }
         return states
     }
+
+    /// Captures the final prompt-token input and output of every attention
+    /// output projection in one uncached forward pass.  This is intentionally
+    /// an SPI rather than a persistent hook API: callers cannot alter the
+    /// forward path, and taps are always removed before returning.
+    @_spi(GemmaEncoder) public func attentionOutputProjectionIO(
+        _ inputs: MLXArray
+    ) -> [(input: MLXArray, output: MLXArray)] {
+        var captured = [(input: MLXArray, output: MLXArray)?](
+            repeating: nil, count: layers.count)
+        for (index, layer) in layers.enumerated() {
+            layer.selfAttn.outputProjectionTap = { input, output in
+                captured[index] = (
+                    input[0, -1].asType(.float32),
+                    output[0, -1].asType(.float32))
+            }
+        }
+        defer {
+            for layer in layers { layer.selfAttn.outputProjectionTap = nil }
+        }
+
+        _ = callAsFunction(inputs, cache: nil)
+        let result = captured.compactMap { $0 }
+        precondition(
+            result.count == layers.count,
+            "Gemma 4 attention output-projection capture missed a decoder layer")
+        eval(result.flatMap { [$0.input, $0.output] })
+        return result
+    }
 }
 
